module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: i128, %b: i128) -> (i8, i8, i8, i8, i8, i8) attributes {arg_names = ["a", "b"], result_names = ["add_low", "add_mid", "sub_low", "sub_mid", "mul_low", "mul_mid"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %sum = pyc.add %a, %b : i128, i128 -> i128
    %diff = pyc.sub %a, %b : i128, i128 -> i128
    %product = pyc.mul %a, %b : i128, i128 -> i128
    %add_low = pyc.trunc %sum : i128 -> i8
    %add_mid = pyc.extract %sum {lsb = 32 : i64, msb = 39 : i64} : i128 -> i8
    %sub_low = pyc.extract %diff {lsb = 0 : i64, msb = 7 : i64} : i128 -> i8
    %sub_mid = pyc.extract %diff {lsb = 32 : i64, msb = 39 : i64} : i128 -> i8
    %mul_low = pyc.extract %product {lsb = 0 : i64, msb = 7 : i64} : i128 -> i8
    %mul_mid = pyc.extract %product {lsb = 32 : i64, msb = 39 : i64} : i128 -> i8
    return %add_low, %add_mid, %sub_low, %sub_mid, %mul_low, %mul_mid : i8, i8, i8, i8, i8, i8
  }
}
