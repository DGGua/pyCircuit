module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: vector<4xi8>, %b: vector<4xi8>) -> (i8, i8) attributes {arg_names = ["a", "b"], result_names = ["lane0", "lane2"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %sum = pyc.add %a, %b : vector<4xi8>, vector<4xi8> -> vector<4xi8>
    %lane0 = pyc.v_get %sum[0] : vector<4xi8> -> i8
    %lane2 = pyc.v_get %sum[2] : vector<4xi8> -> i8
    return %lane0, %lane2 : i8, i8
  }
}
