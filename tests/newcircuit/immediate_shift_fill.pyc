module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: i16) -> (i4, i4, i4, i4, i4) attributes {arg_names = ["a"], result_names = ["lowfill", "highfill", "signfill", "leftzero", "rightzero"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %sh = pyc.shli %a {amount = 5 : i64} : i16
    %ls = pyc.lshri %a {amount = 5 : i64} : i16
    %as = pyc.ashri %a {amount = 5 : i64} : i16
    %shz = pyc.shli %a {amount = 10 : i64} : i16
    %lsz = pyc.lshri %a {amount = 10 : i64} : i16
    %lowfill = pyc.extract %sh {lsb = 2 : i64, msb = 5 : i64} : i16 -> i4
    %highfill = pyc.extract %ls {lsb = 9 : i64, msb = 12 : i64} : i16 -> i4
    %signfill = pyc.extract %as {lsb = 9 : i64, msb = 12 : i64} : i16 -> i4
    %leftzero = pyc.extract %shz {lsb = 2 : i64, msb = 5 : i64} : i16 -> i4
    %rightzero = pyc.extract %lsz {lsb = 12 : i64, msb = 15 : i64} : i16 -> i4
    return %lowfill, %highfill, %signfill, %leftzero, %rightzero : i4, i4, i4, i4, i4
  }
}
