module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: i16, %amount: i2) -> (i1, i1, i1) attributes {arg_names = ["a", "amount"], result_names = ["left", "logical", "arithmetic"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %sh = pyc.shl %a, %amount : i16, i2
    %ls = pyc.lshr %a, %amount : i16, i2
    %as = pyc.ashr %a, %amount : i16, i2
    %left = pyc.extract %sh {lsb = 1 : i64, msb = 1 : i64} : i16 -> i1
    %logical = pyc.extract %ls {lsb = 0 : i64, msb = 0 : i64} : i16 -> i1
    %arithmetic = pyc.extract %as {lsb = 15 : i64, msb = 15 : i64} : i16 -> i1
    return %left, %logical, %arithmetic : i1, i1, i1
  }
}
