module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: i130, %b: i130, %c: i130) -> (i130, i1) attributes {arg_names = ["a", "b", "c"], result_names = ["root", "y"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %x = pyc.add %a, %b : i130, i130 -> i130
    %root = pyc.and %x, %c : i130, i130 -> i130
    %bit = pyc.extract %root {lsb = 65 : i64, msb = 65 : i64} : i130 -> i1
    %y = pyc.not %bit : i1
    return %root, %y : i130, i1
  }
}
