module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: i16, %b: i16) -> (i8, i8) attributes {arg_names = ["a", "b"], result_names = ["lo", "hi"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %and = pyc.and %a, %b : i16, i16 -> i16
    %lo = pyc.extract %and {lsb = 0 : i64, msb = 7 : i64} : i16 -> i8
    %hi = pyc.extract %and {lsb = 4 : i64, msb = 11 : i64} : i16 -> i8
    return %lo, %hi : i8, i8
  }
}
