module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%v: vector<3x4xi8>) -> i8 attributes {arg_names = ["v"], result_names = ["y"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %one = pyc.constant 1 : i8
    %sums = pyc.v_add_reduce %v {dim = 0 : i64, mode = "chain"} : vector<3x4xi8> -> vector<4xi8>
    %col2 = pyc.v_get %sums[2] : vector<4xi8> -> i8
    %y = pyc.add %col2, %one : i8, i8 -> i8
