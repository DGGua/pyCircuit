module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%sel: i1, %a: i24, %b: i24) -> (i8, i8, i4) attributes {arg_names = ["sel", "a", "b"], result_names = ["lo", "overlap", "hi"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %selected = pyc.mux %sel, %a, %b : i1, i24, i24 -> i24
    %lo = pyc.extract %selected {lsb = 0 : i64, msb = 7 : i64} : i24 -> i8
    %overlap = pyc.extract %selected {lsb = 4 : i64, msb = 11 : i64} : i24 -> i8
    %hi = pyc.extract %selected {lsb = 20 : i64, msb = 23 : i64} : i24 -> i4
    return %lo, %overlap, %hi : i8, i8, i4
  }
}
