module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%sel: i1, %a: vector<4xi8>, %b: vector<4xi8>) -> (i8, i8) attributes {arg_names = ["sel", "a", "b"], result_names = ["lane0", "lane3"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %selected = arith.select %sel, %a, %b : vector<4xi8>
    %lane0 = pyc.v_get %selected[0] : vector<4xi8> -> i8
    %lane3 = pyc.v_get %selected[3] : vector<4xi8> -> i8
    return %lane0, %lane3 : i8, i8
  }
}
