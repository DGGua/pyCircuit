module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%sel: i1, %a: i16, %b: i16, %c: i16) -> i4 attributes {arg_names = ["sel", "a", "b", "c"], result_names = ["y"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %wide = pyc.and %a, %b : i16, i16 -> i16
    %chosen = pyc.mux %sel, %wide, %c : i1, i16, i16 -> i16
    %y = pyc.extract %chosen {lsb = 8 : i64, msb = 11 : i64} : i16 -> i4
    return %y : i4
  }
}
