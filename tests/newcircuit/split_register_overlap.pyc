module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%clk: !pyc.clock, %rst: !pyc.reset, %en: i1, %d: i16) -> (i8, i8) attributes {arg_names = ["clk", "rst", "en", "d"], result_names = ["lo", "mid"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":1,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %init = pyc.constant 4660 : i16
    %q = pyc.reg %clk, %rst, %en, %d, %init : i16
