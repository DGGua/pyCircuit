module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: vector<2xi8>) -> (i8, vector<3xi8>) attributes {arg_names = ["a"], result_names = ["row_item", "col_row"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %rows = pyc.v_broadcast_dim %a to 3, 0 : vector<2xi8> -> vector<3x2xi8>
    %cols = pyc.v_broadcast_dim %a to 3, 1 : vector<2xi8> -> vector<2x3xi8>
    %row = pyc.v_get %rows[2] : vector<3x2xi8> -> vector<2xi8>
    %row_item = pyc.v_get %row[1] : vector<2xi8> -> i8
    %col_row = pyc.v_get %cols[1] : vector<2x3xi8> -> vector<3xi8>
    return %row_item, %col_row : i8, vector<3xi8>
  }
}
