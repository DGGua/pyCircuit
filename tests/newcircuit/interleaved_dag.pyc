module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: i8, %b: i8, %c: i8, %d: i8) -> (i8, i8) attributes {arg_names = ["a", "b", "c", "d"], result_names = ["y", "z"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %a1 = pyc.add %a, %b : i8, i8 -> i8
    %b1 = pyc.add %c, %d : i8, i8 -> i8
    %y = pyc.add %a1, %a : i8, i8 -> i8
    %z = pyc.add %b1, %c : i8, i8 -> i8
    return %y, %z : i8, i8
  }
}
