module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%v: vector<3x4xi8>) -> (i8, i8, i8, i8) attributes {arg_names = ["v"], result_names = ["or0", "or2", "and1", "sum2"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %ors = pyc.v_or_reduce %v {dim = 1 : i64, mode = "chain"} : vector<3x4xi8> -> vector<3xi8>
    %ands = pyc.v_and_reduce %v {dim = 1 : i64, mode = "tree"} : vector<3x4xi8> -> vector<3xi8>
    %sums = pyc.v_add_reduce %v {dim = 0 : i64, mode = "chain"} : vector<3x4xi8> -> vector<4xi8>
    %or0 = pyc.v_get %ors[0] : vector<3xi8> -> i8
    %or2 = pyc.v_get %ors[2] : vector<3xi8> -> i8
    %and1 = pyc.v_get %ands[1] : vector<3xi8> -> i8
    %sum2 = pyc.v_get %sums[2] : vector<4xi8> -> i8
    return %or0, %or2, %and1, %sum2 : i8, i8, i8, i8
  }
}
