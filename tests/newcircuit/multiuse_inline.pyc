module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: i16, %b: i16, %c: i16) -> (i16, i16) attributes {arg_names = ["a", "b", "c"], result_names = ["x", "y"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %neg = pyc.not %a : i16
    %x = pyc.add %neg, %b : i16, i16 -> i16
    %y = pyc.sub %neg, %c : i16, i16 -> i16
    return %x, %y : i16, i16
  }
}
