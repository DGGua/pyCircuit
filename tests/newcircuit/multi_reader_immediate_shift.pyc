module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%a: i128) -> (i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8) attributes {arg_names = ["a"], result_names = ["sh_low", "sh_mid", "ls_low", "ls_mid", "as_low", "as_mid", "lsfill_low", "lsfill_mid", "fill_low", "fill_mid", "zero_low", "zero_mid", "sign_low", "sign_mid", "dyn_sh_low", "dyn_sh_mid", "dyn_ls_low", "dyn_ls_mid", "dyn_as_low", "dyn_as_mid"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %sh = pyc.shli %a {amount = 7 : i64} : i128
