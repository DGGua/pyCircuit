    %zero_low = pyc.trunc %zero : i128 -> i8
    %zero_mid = pyc.extract %zero {lsb = 32 : i64, msb = 39 : i64} : i128 -> i8
    %sign_low = pyc.trunc %sign : i128 -> i8
    %sign_mid = pyc.extract %sign {lsb = 32 : i64, msb = 39 : i64} : i128 -> i8
    %dyn_sh_low = pyc.trunc %dyn_sh : i128 -> i8
    %dyn_sh_mid = pyc.extract %dyn_sh {lsb = 32 : i64, msb = 39 : i64} : i128 -> i8
    %dyn_ls_low = pyc.trunc %dyn_ls : i128 -> i8
