module attributes {pyc.top = @top, pyc.frontend.contract = "pycircuit"} {
  func.func @top(%v: vector<2xi8>, %c: i8) -> i8 attributes {arg_names = ["v", "c"], result_names = ["y"], pyc.kind = "module", pyc.inline = "false", pyc.params = "{}", pyc.base = "top", pyc.struct.metrics = "{\"source_loc\":0,\"ast_node_count\":0,\"hardware_call_count\":0,\"loop_count\":0,\"module_call_count\":0,\"state_call_count\":0,\"estimated_inline_cost\":0,\"instance_count\":0,\"state_alloc_count\":0,\"collection_count\":0,\"collection_instance_count\":0,\"module_family_collection_count\":0,\"repeated_body_clusters\":[]}", pyc.struct.collections = "[]"} {
    %picked = pyc.v_get %v[0] : vector<2xi8> -> i8
    %barrier = pyc.comb(%c) : (i8) -> i8 {
      ^bb0(%c0: i8):
        %inv = pyc.not %c0 : i8
        pyc.yield %inv : i8
    }
    %sum = pyc.add %picked, %barrier : i8, i8 -> i8
    %y = pyc.xor %sum, %c : i8, i8 -> i8
    return %y : i8
  }
}
